# Build from the repository root, not apps/api.
FROM node:22.23.4-alpine3.24@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS codec
WORKDIR /src
COPY . .
RUN corepack enable \
    && CI=1 pnpm install --frozen-lockfile --ignore-scripts --filter '@plane/editor...' \
    && pnpm --filter @plane/types --filter @plane/constants --filter @plane/utils --filter @plane/hooks --filter @plane/propel --filter @plane/ui -r exec tsdown \
    && pnpm --filter @plane/editor exec tsdown --config ../../deployments/portfall/codec.config.mjs

FROM python:3.12.16-alpine3.24@sha256:44bf3bcc455e0c9ccd912b78f39019b2f7e9d2f4fb47c6d6973c7638a99aff14 AS dependencies
WORKDIR /build
COPY apps/api/requirements/portfall.lock requirements.lock
RUN apk add --no-cache gcc g++ musl-dev libffi-dev postgresql-dev cargo make linux-headers \
    && python -m pip wheel --require-hashes --no-cache-dir -r requirements.lock --wheel-dir /wheels \
    && cd /wheels && sha256sum *.whl > SHA256SUMS

FROM python:3.12.16-alpine3.24@sha256:44bf3bcc455e0c9ccd912b78f39019b2f7e9d2f4fb47c6d6973c7638a99aff14 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apk add --no-cache bash libpq libxslt xmlsec libstdc++ libatomic \
    && addgroup -g 10001 plane \
    && adduser -D -u 10001 -G plane plane
RUN --mount=type=bind,from=dependencies,source=/wheels,target=/wheels \
    python -m pip install --no-cache-dir --no-index --no-deps /wheels/*.whl \
    && python -m pip check
COPY --from=codec /usr/local/bin/node /usr/local/bin/node
COPY --from=codec /codec/project-bundle-codec.mjs /code/project-bundle-codec.mjs
COPY --from=dependencies /wheels/SHA256SUMS /usr/share/plane-build/python-wheels.sha256
COPY apps/api/requirements/portfall.lock /usr/share/plane-build/requirements.lock
WORKDIR /code
COPY apps/api/manage.py apps/api/package.json ./
COPY apps/api/plane ./plane
COPY apps/api/templates ./templates
COPY apps/api/bin ./bin
RUN mkdir -p /code/plane/logs /code/plane/static-assets/collected-static \
    && chmod +x ./bin/* \
    && chown -R plane:plane /code/plane/logs /code/plane/static-assets \
    && /usr/local/bin/node --version \
    && python -m pip list --format=json > /usr/share/plane-build/python-packages.json \
    && apk info -v > /usr/share/plane-build/alpine-packages.txt
USER 10001:10001
EXPOSE 8000
CMD ["./bin/docker-entrypoint-api.sh"]
